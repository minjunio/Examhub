# ─── ExamHub environment (copy to .env or paste into Render) ───

# Public site URL after deploy (no trailing slash)
# Example: https://examhub.onrender.com
BETTER_AUTH_URL=https://YOUR-APP.onrender.com

# Random long secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Neon Postgres connection string (https://neon.tech)
# Example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Keep auth ON for production
VITE_AUTH_ENABLED=true

# Optional: public hostname for absolute SEO links
# VITE_PUBLIC_HOSTNAME=examhub.onrender.com

# ─── Google sign-in (optional if you only use email/password) ───
# This app can use email/password without Google.
# For Google OAuth via your own setup, configure Google Cloud OAuth client
# and any broker vars your host injects. For Render + email/password only:
# leave Grok broker vars empty — users use Create account / email login.
#
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=

# Node env
NODE_ENV=production
